# Environment template (Development)
NODE_ENV=development
APP_STAGE=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Required in staging/production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nilas_treat
REQUIRE_POSTGRES=false

# Session Signing Secret (32+ random characters)
AUTH_SECRET=replace-with-at-least-32-random-characters-for-jwt-signing

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Owner Admin Account
DEFAULT_ADMIN_PHONE=9344597833
DEFAULT_ADMIN_EMAIL=admin@nilastreat.com
DEFAULT_ADMIN_USERNAME=nila treat
DEFAULT_ADMIN_PASSWORD=change-me-strong-password
ADMIN_MFA_REQUIRED=false
DEFAULT_ADMIN_MFA_SECRET=

# Redis & Object Storage (Optional in dev, recommended in production)
REDIS_URL=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
SENTRY_DSN=
